<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="PLAIN" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%X{trace.id},%X{span.id}] [%X{userId},%X{tenantId}] [%X{requestId}] %logger{36} - %msg%n"/>
        </Console>
        <Console name="JSON" target="SYSTEM_OUT">
            <EcsLayout serviceName="grpc-observability-demo"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.springframework.grpc" level="WARN"/>
        <Logger name="io.grpc" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="${env:LOG_FORMAT:-JSON}"/>
        </Root>
    </Loggers>
</Configuration>
